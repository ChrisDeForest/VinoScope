# VinoScope API (FastAPI under uvicorn), reachable only through nginx.
# Installed by deploy/install.sh. Edit it in the repo, not on the Pi.
[Unit]
Description=VinoScope API (FastAPI + uvicorn on 127.0.0.1:8000)
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service
# Email if it keeps failing and systemd stops restarting it
OnFailure=service-failure-notify@%n.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/chris/vinoscope/backend
# DATABASE_URL, ADMIN_API_KEY, CORS_ORIGINS, VINOSCOPE_ENV=production (root-only file)
EnvironmentFile=/etc/vinoscope.env
Environment=PYTHONDONTWRITEBYTECODE=1
# Apply any new database migrations before starting. A no-op when already up to date.
# If a migration fails the API doesn't start, and the OnFailure email says why.
ExecStartPre=/home/chris/vinoscope/.venv/bin/alembic -c /home/chris/vinoscope/backend/alembic.ini upgrade head
ExecStart=/home/chris/vinoscope/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header
Restart=on-failure
RestartSec=3

# Hardening: a throwaway unprivileged user that can read the code but write nowhere
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=512M

[Install]
WantedBy=multi-user.target
