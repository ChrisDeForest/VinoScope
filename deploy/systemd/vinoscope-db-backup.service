# Nightly dump of the VinoScope database. Admin edits exist only in this database, so this is
# the only copy of them. Installed by deploy/install.sh.
[Unit]
Description=Back up the VinoScope database (pg_dump)
After=postgresql.service
Requires=postgresql.service
OnFailure=service-failure-notify@%n.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/home/chris/vinoscope/deploy/bin/backup-vinoscope-db.sh
