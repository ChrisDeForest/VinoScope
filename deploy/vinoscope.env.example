# Template for /etc/vinoscope.env on the Pi (root-only: sudo chmod 600 /etc/vinoscope.env).
# Read by vinoscope-api.service. Never commit the real file.

VINOSCOPE_ENV=production
DATABASE_URL=postgresql+psycopg://vinoscope:CHANGE_ME@127.0.0.1:5432/vinoscope
# Long random value: openssl rand -hex 32. Paste it into the Admin page to edit wines.
ADMIN_API_KEY=CHANGE_ME
# The browser calls the API on the same domain, so CORS isn't needed; this just keeps it tight.
CORS_ORIGINS=https://wines.chrisdeforest.dev
